# UseMyContext folder mapping.
# Copy this file to ".umc" in a repo to map that folder to one of your projects.
# Every OpenCode session started in this folder then reads the mapped context.
# Find projectId and @handle in the UseMyContext web app (usemycontext.ai).

# projectId: letters, digits, _ and - only, up to 32 characters.
# handle: @ followed by letters, digits and - only, up to 40 characters.
# Anything else and the whole marker is ignored.
projectId=p2
handle=@work
